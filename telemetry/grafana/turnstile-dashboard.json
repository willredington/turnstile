    {
      "type": "timeseries",
      "title": "Keystroke latency",
      "description": "Keypress to laid-out document, measured in the browser.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(turnstile_editor_keystroke_latency_bucket{session_id=~\"$session\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(turnstile_editor_keystroke_latency_bucket{session_id=~\"$session\"}[$__rate_interval])))",
