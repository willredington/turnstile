    {
      "type": "timeseries",
      "title": "Cost by model",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (model) (clamp_min(claude_code_cost_usage_USD_total{session_id=~\"$session\"} - claude_code_cost_usage_USD_total{session_id=~\"$session\"} offset $__interval, 0) or (claude_code_cost_usage_USD_total{session_id=~\"$session\"} unless claude_code_cost_usage_USD_total{session_id=~\"$session\"} offset $__interval))",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 9
    },
