    {
      "type": "logs",
      "title": "Agent events",
      "description": "Prompts, API requests and errors, tool decisions and results, from the CLI's own event log. Prompt text is only present if OTEL_LOG_USER_PROMPTS is set in your shell.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"claude-code\", session_id=~\"$session\"} | event_name=~\"user_prompt|api_request|api_error|tool_result|tool_decision\""
