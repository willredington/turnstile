{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Turnstile",
  "version": "1.0.0",
  "identifier": "dev.turnstile.desktop",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "bun run prepare-sidecar",
    "beforeBuildCommand": "bun run prepare-sidecar"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Turnstile",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/turnstile"],
    "resources": ["resources/claude-cli"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
